{
  "name": "rorschach",
  "version": "0.1.0",
  "description": "A review station: walk through a queue of web pages or images, answer a question about each, and write the answers to a file.",
  "author": "John Stump",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Johnwstump/Rorschach.git"
  },
  "homepage": "https://github.com/Johnwstump/Rorschach#readme",
  "bugs": {
    "url": "https://github.com/Johnwstump/Rorschach/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "sample": "electron . samples/sample-task.json",
    "icon": "node scripts/icon-svg.js && electron scripts/icon-raster.js",
    "dist": "electron-builder",
    "test": "node --test test/*.test.js"
  },
  "build": {
    "appId": "dev.rorschach.app",
    "productName": "Rorschach",
    "icon": "build/icon.png",
    "files": [
      "main.js",
      "preload.js",
      "lib/**",
      "panel/**",
      "viewer/**",
      "build/icon.ico",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "opentype.js": "^2.0.0"
  }
}
